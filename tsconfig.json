{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@mastors/core": ["./scss/_index.scss"],
      "@tokens/*": ["./scss/tokens/*"],
      "@mixins/*": ["./scss/mixins/*"],
      "@functions/*": ["./scss/functions/*"]
    }
  }
}
